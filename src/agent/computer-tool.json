{
  "type": "function",
  "function": {
    "name": "computer",
    "description": "Perform one computer action on the current screen.",
    "parameters": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "click",
            "left_click",
            "right_click",
            "double_click",
            "left_click_drag",
            "scroll",
            "type",
            "key",
            "wait",
            "screenshot",
            "none",
            "done",
            "confirm",
            "plan"
          ]
        },
        "coordinate": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000
          },
          "maxItems": 4,
          "minItems": 2,
          "description": "[x,y] for clicks and scroll, normalized 0-1000."
        },
        "start_coordinate": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000
          },
          "maxItems": 2,
          "minItems": 2
        },
        "end_coordinate": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000
          },
          "maxItems": 2,
          "minItems": 2
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "description": "Only for type (text to type), done (evidence), none (answer) and confirm (question)."
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "minItems": 1,
          "maxItems": 7,
          "description": "Only for plan: short steps, each \"what to do -> what will be visible when it worked\"."
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "Only for plan, when changing an existing plan: what went wrong."
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Only for key: one chord such as ctrl+l or enter."
        },
        "direction": {
          "type": "string",
          "enum": [
            "up",
            "down",
            "left",
            "right"
          ]
        },
        "amount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "screen": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "description": "One short sentence describing what THIS screenshot shows."
        },
        "last_action": {
          "type": "string",
          "enum": [
            "worked",
            "failed",
            "unclear"
          ],
          "description": "Did your previous action work, judging by THIS screenshot? Omit on the first action."
        },
        "step_done": {
          "type": "boolean",
          "description": "true only when the current plan step's success condition is visible now."
        }
      },
      "required": [
        "action"
      ],
      "additionalProperties": false
    }
  }
}
